 <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "DefinedTermSet", "@id": "https://flowerhornhobby.com/glossary/#terms", "name": "Flowerhorn glossary", "url": "https://flowerhornhobby.com/glossary/", "hasDefinedTerm": [{"@type": "DefinedTerm", "name": "Culling", "description": "Removing fry that don’t show desirable traits during grading. Responsible breeders sell culls as pet-grade fish. See breeding .", "url": "https://flowerhornhobby.com/glossary/#culling"}, {"@type": "DefinedTerm", "name": "Divider breeding", "description": "Separating a potential pair with a clear or mesh partition so they can see each other without fighting, until both are ready to spawn.", "url": "https://flowerhornhobby.com/glossary/#divider"}, {"@type": "DefinedTerm", "name": "F0, F1, F2, F3, F4", "description": "Generation labels, mostly used for Kamfa. F0 is the original cross, F1 its offspring and so on. Not strain names. Later generations are generally more fertile and less pure.", "url": "https://flowerhornhobby.com/glossary/#f0-f4"}, {"@type": "DefinedTerm", "name": "Faders", "description": "Golden Base flowerhorns that are born dark and gradually lose their black coloring to reveal gold, yellow or orange.", "url": "https://flowerhornhobby.com/glossary/#faders"}, {"@type": "DefinedTerm", "name": "Flower", "description": "The row of black blotches running along the side of a flowerhorn. Its shape, thickness and continuity are graded, and in feng shui the pattern may be read as characters or numbers.", "url": "https://flowerhornhobby.com/glossary/#flower"}, {"@type": "DefinedTerm", "name": "Golden Base / Golden Monkey", "description": "One of the founding flowerhorn lines, known for gold and yellow color. A hardy, affordable choice. Full guide .", "url": "https://flowerhornhobby.com/glossary/#golden-base"}, {"@type": "DefinedTerm", "name": "Grading", "description": "Sorting young fish by quality, repeatedly, as they grow. The main criteria are kok, flower, pearling, color, body shape and eyes. Full guide .", "url": "https://flowerhornhobby.com/glossary/#grading"}, {"@type": "DefinedTerm", "name": "Hard head", "description": "A firm kok built from fatty tissue, typical of Zhen Zhu lines. Tends to hold its shape.", "url": "https://flowerhornhobby.com/glossary/#hard-head"}, {"@type": "DefinedTerm", "name": "Hua luo han 花羅漢", "description": "The Chinese name for the flowerhorn: “flower luohan.” Often shortened to luohan or louhan.", "url": "https://flowerhornhobby.com/glossary/#hua-luo-han"}, {"@type": "DefinedTerm", "name": "Kamfa", "description": "A prized strain with a square body, very large kok, heavy pearling and often a sunken eye, developed by crossing flowerhorns with Vieja cichlids. Sometimes spelled Kam Fa. Full guide .", "url": "https://flowerhornhobby.com/glossary/#kamfa"}, {"@type": "DefinedTerm", "name": "Kok", "description": "The hump on a flowerhorn’s forehead; the scientific term is nuchal hump. Usually develops between 6 and 12 months. Its size is the single biggest factor in a fish’s value and feng shui significance. Full guide .", "url": "https://flowerhornhobby.com/glossary/#kok"}, {"@type": "DefinedTerm", "name": "Luohan 羅漢", "description": "The Chinese term for an arhat, an enlightened Buddhist saint, and a common shorthand for the flowerhorn.", "url": "https://flowerhornhobby.com/glossary/#luohan"}, {"@type": "DefinedTerm", "name": "Pearling", "description": "Iridescent white or blue-green spangles on the scales, fins and face. Heavy, even pearling is a mark of quality, especially in Zhen Zhu and Kamfa.", "url": "https://flowerhornhobby.com/glossary/#pearling"}, {"@type": "DefinedTerm", "name": "Red Dragon / SRD", "description": "Lines bred for solid red coverage. SRD stands for Super Red Dragon, the most saturated grade. Full guide .", "url": "https://flowerhornhobby.com/glossary/#red-dragon"}, {"@type": "DefinedTerm", "name": "Short body", "description": "A flowerhorn with a compressed, rounded body, also called balloon. Popular but prone to swim bladder problems. Full guide .", "url": "https://flowerhornhobby.com/glossary/#short-body"}, {"@type": "DefinedTerm", "name": "Thai Silk", "description": "A Thai-developed line with a metallic white to silver-blue sheen, sometimes sold as Titanium. Full guide .", "url": "https://flowerhornhobby.com/glossary/#thai-silk"}, {"@type": "DefinedTerm", "name": "Water head", "description": "A large, softer kok filled more with fluid than fat, typical of Kamfa. Can look spectacular but may shrink with stress or age.", "url": "https://flowerhornhobby.com/glossary/#water-head"}, {"@type": "DefinedTerm", "name": "Wet pet", "description": "Hobby slang for large, interactive fish, cichlids especially, that behave more like pets than ornaments. See the fish that acts like a dog .", "url": "https://flowerhornhobby.com/glossary/#wet-pet"}, {"@type": "DefinedTerm", "name": "Zhen Zhu (ZZ)", "description": "“Pearl” in Chinese. One of the founding flowerhorn lines, known for heavy pearling and a firm kok. Full guide .", "url": "https://flowerhornhobby.com/glossary/#zhen-zhu"}]}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://flowerhornhobby.com/"}, {"@type": "ListItem", "position": 2, "name": "Glossary", "item": "https://flowerhornhobby.com/glossary/"}]}]}</script>
