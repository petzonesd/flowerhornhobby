 <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Article", "@id": "https://flowerhornhobby.com/vi/origins/#article", "headline": "Cá la hán từ đâu mà có", "description": "Cá la hán được lai tạo ở Malaysia thập niên 1990 từ cá két đỏ và cichlid Trung Mỹ. Trọn vẹn lịch sử: phép lai đầu tiên, thời hoàng kim, sụp đổ và hôm nay.", "url": "https://flowerhornhobby.com/vi/origins/", "mainEntityOfPage": "https://flowerhornhobby.com/vi/origins/", "image": ["https://flowerhornhobby.com/assets/photos/zz-flowerhorn-male.jpg", "https://flowerhornhobby.com/assets/og.png"], "datePublished": "2026-09-21", "dateModified": "2026-09-21", "wordCount": 1907, "author": {"@type": "Person", "@id": "https://flowerhornhobby.com/about/#roger-ma", "name": "Roger Ma", "jobTitle": "Founder, Pet Zone Tropical Fish", "worksFor": {"@id": "https://www.petzonesd.com/#organization"}}, "publisher": {"@id": "https://www.petzonesd.com/#organization"}, "inLanguage": "vi"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://flowerhornhobby.com/vi/"}, {"@type": "ListItem", "position": 2, "name": "Nguồn gốc", "item": "https://flowerhornhobby.com/vi/origins/"}]}, {"@type": "FAQPage", "@id": "https://flowerhornhobby.com/vi/origins/#faq", "url": "https://flowerhornhobby.com/vi/origins/", "mainEntity": [{"@type": "Question", "name": "Cá la hán có nguồn gốc từ đâu?", "acceptedAnswer": {"@type": "Answer", "text": "Malaysia. Các nhà lai tạo ở đó đã tạo ra cá la hán vào thập niên 1990 bằng cách cho các loài cichlid Trung Mỹ, chủ yếu là cá quỷ đỏ và trimac, lai với cá két đỏ, một loại cá lai được tạo ra ở Đài Loan."}}, {"@type": "Question", "name": "Cá la hán được tạo ra khi nào?", "acceptedAnswer": {"@type": "Answer", "text": "Những phép lai có chủ đích đầu tiên thường được xác định vào năm 1993 hoặc 1994, và kiểu cá có thể nhận ra là cá la hán, mang tên hua luo han, xuất hiện vào khoảng năm 1998."}}, {"@type": "Question", "name": "Cá la hán được lai từ hai loài cá nào?", "acceptedAnswer": {"@type": "Answer", "text": "Không có công thức nào chỉ gồm hai loài cả. Cá quỷ đỏ và trimac là hai loài bố mẹ được nhắc tới nhiều nhất, nhưng cá két đỏ, cá Midas, festae và sau này là cichlid Vieja đều từng được sử dụng, và mỗi dòng mang một tổ hợp khác nhau."}}, {"@type": "Question", "name": "Vì sao cá la hán bị cấm ở một số nơi?", "acceptedAnswer": {"@type": "Answer", "text": "Vì cá la hán bị thả ra đã trở thành loài xâm hại ở nhiều vùng Đông Nam Á. Úc cấm nhập khẩu loài cá này. Ở Mỹ, hầu hết các nơi đều cho phép nuôi, nhưng bạn hãy kiểm tra quy định của tiểu bang và địa phương, và tuyệt đối đừng thả cá ra ngoài."}}]}]}</script>
