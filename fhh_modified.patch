 <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Article", "@id": "https://flowerhornhobby.com/vi/care/diseases/#article", "headline": "Bệnh ở cá la hán và cách điều trị", "description": "Bệnh cá la hán: thủng đầu, bong bóng và chướng bụng, đốm trắng, thối vây, nấm, đục mắt và căng thẳng, cùng cách xử lý nước trước tiên và cách lập bể cách ly.", "url": "https://flowerhornhobby.com/vi/care/diseases/", "mainEntityOfPage": "https://flowerhornhobby.com/vi/care/diseases/", "image": ["https://flowerhornhobby.com/assets/photos/healthy-srd-zz-flowerhorn.jpg", "https://flowerhornhobby.com/assets/og.png"], "datePublished": "2026-09-21", "dateModified": "2026-09-21", "wordCount": 2401, "author": {"@type": "Person", "@id": "https://flowerhornhobby.com/about/#roger-ma", "name": "Roger Ma", "jobTitle": "Founder, Pet Zone Tropical Fish", "worksFor": {"@id": "https://www.petzonesd.com/#organization"}}, "publisher": {"@id": "https://www.petzonesd.com/#organization"}, "inLanguage": "vi"}, {"@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://flowerhornhobby.com/vi/"}, {"@type": "ListItem", "position": 2, "name": "Cẩm nang nuôi", "item": "https://flowerhornhobby.com/vi/care/"}, {"@type": "ListItem", "position": 3, "name": "Bệnh cá", "item": "https://flowerhornhobby.com/vi/care/diseases/"}]}, {"@type": "FAQPage", "@id": "https://flowerhornhobby.com/vi/care/diseases/#faq", "url": "https://flowerhornhobby.com/vi/care/diseases/", "mainEntity": [{"@type": "Question", "name": "Vì sao cá la hán của tôi bị đen màu?", "acceptedAnswer": {"@type": "Answer", "text": "Màu sẫm và sọc đen thường là dấu hiệu căng thẳng. Nguyên nhân hay gặp là bể mới, nước kém, nhiệt độ thay đổi, cá nuôi chung hoặc bệnh giai đoạn đầu, nên hãy thử nước trước rồi tìm thêm các triệu chứng khác."}}, {"@type": "Question", "name": "Chữa bệnh thủng đầu ở cá la hán như thế nào?", "acceptedAnswer": {"@type": "Answer", "text": "Người nuôi bắt đầu bằng cách cải thiện nước và lọc, bỏ than hoạt tính, cho ăn đa dạng và giảm căng thẳng. Khi nghi có ký sinh trùng đường ruột, metronidazole thường được dùng, theo đúng nhãn sản phẩm hoặc chỉ dẫn của bác sĩ thú y."}}, {"@type": "Question", "name": "Vì sao cá la hán của tôi nổi ngửa bụng?", "acceptedAnswer": {"@type": "Answer", "text": "Đó là dấu hiệu bệnh bong bóng, thường do cho ăn quá nhiều, táo bón hoặc nước kém. Kiểm tra nước, cho cá nhịn ăn vài ngày, và đưa đi bác sĩ thú y nếu cá không khá lên."}}, {"@type": "Question", "name": "Vì sao cá la hán của tôi không chịu ăn?", "acceptedAnswer": {"@type": "Answer", "text": "Lý do thường gặp là căng thẳng vì chuyển bể, vấn đề về nước hoặc bệnh. Cá mới về có thể bỏ ăn vài ngày, nhưng cá đã quen bể mà ngưng ăn thì cần thử nước và xem kỹ các triệu chứng."}}, {"@type": "Question", "name": "Có dùng muối hồ cá cho cá la hán được không?", "acceptedAnswer": {"@type": "Answer", "text": "Muối hồ cá thường được dùng để trị đốm trắng và khi cá bị căng thẳng nhẹ hoặc có vết thương, và cá la hán nhìn chung chịu được muối. Hãy làm theo hướng dẫn trên nhãn và loại muối ra dần qua các lần thay nước khi chữa xong."}}]}]}</script>
