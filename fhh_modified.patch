 <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "WebSite", "@id": "https://flowerhornhobby.com/vi/#website", "url": "https://flowerhornhobby.com/vi/", "name": "Flowerhorn Hobby", "description": "Cá la hán từ đâu mà có, được nhân giống ra sao, vì sao được xem là cá phong thủy và vì sao người nuôi quý nó như chó cưng. Từ Pet Zone, San Diego.", "publisher": {"@id": "https://www.petzonesd.com/#organization"}, "inLanguage": "vi"}, {"@type": "FAQPage", "@id": "https://flowerhornhobby.com/vi/#faq", "url": "https://flowerhornhobby.com/vi/", "mainEntity": [{"@type": "Question", "name": "Cá la hán có phải là loài tự nhiên không?", "acceptedAnswer": {"@type": "Answer", "text": "Không. Cá la hán là cá lai do giới nuôi cá cảnh tạo ra, đầu tiên ở Malaysia vào thập niên 1990. Nó không có vùng phân bố bản địa. Những con cá la hán hoang dã hiện có ở một số nơi tại Malaysia và Singapore đều là hậu duệ của cá do con người thả ra."}}, {"@type": "Question", "name": "“Flowerhorn” nghĩa là gì?", "acceptedAnswer": {"@type": "Answer", "text": "Đó là cách dịch thoáng tên tiếng Hoa 花羅漢 (huā luóhàn). “Flower” (hoa) chỉ những hoa văn trên thân, còn “horn” (sừng) chỉ cái bướu trên trán, mà người nuôi gọi là u đầu hay kok."}}, {"@type": "Question", "name": "Vì sao cá la hán được xem là mang lại may mắn?", "acceptedAnswer": {"@type": "Answer", "text": "Trong phong thủy, cá và nước gắn liền với sự sung túc. Cá la hán còn có thêm cái u đầu giống vầng trán gồ cao của Thọ Tinh, vị thần trường thọ, những vệt hoa mà một số chủ nuôi đọc thành chữ hoặc con số, cùng màu đỏ và vàng kim tượng trưng cho tài lộc. Bài viết về phong thủy của chúng tôi có đầy đủ chi tiết."}}, {"@type": "Question", "name": "Cá la hán có thật sự nhận ra chủ không?", "acceptedAnswer": {"@type": "Answer", "text": "Người nuôi đều kể rằng cá la hán đối xử với chủ khác hẳn với người lạ: ra mặt kính đón người này, nhưng lại xòe vây với người kia. Nghiên cứu đã cho thấy ít nhất một số loài cá có thể phân biệt khuôn mặt người, và cá cichlid thuộc nhóm có hành vi phức tạp nhất trong giới cá cảnh. Xem thêm con cá cư xử như chó cưng ."}}]}]}</script>
